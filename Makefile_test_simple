CXX = g++
CXXFLAGS = -std=c++20 -Wall -Wextra -Werror -pedantic -O2
LDFLAGS = -ldl

# Target executables
TARGET_SIMPLE = test_simulator_simple
TARGET_COMPARATIVE = test_comparative_simple
TARGET_REAL = test_comparative_real

# Default target
all: $(TARGET_SIMPLE) $(TARGET_COMPARATIVE) $(TARGET_REAL)

# Build the simple test executable
$(TARGET_SIMPLE): test_simulator_simple.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

# Build the comparative test executable
$(TARGET_COMPARATIVE): test_comparative_simple.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

# Build the real comparative test executable
$(TARGET_REAL): test_comparative_real.cpp
	$(CXX) $(CXXFLAGS) -Icommon -IUserCommon -c Simulator/GameRunner.cpp -o GameRunner.o
	$(CXX) $(CXXFLAGS) -Icommon -IUserCommon $< GameRunner.o -o $@ $(LDFLAGS) GameManager/GameManager_318772340_206580102.so Algorithm/Algorithm_318772340_206580102.so

# Clean target
clean:
	rm -f $(TARGET_SIMPLE) $(TARGET_COMPARATIVE) $(TARGET_REAL)

.PHONY: all clean 